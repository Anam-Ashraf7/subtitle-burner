# Copy to `.env` and fill in. `.env` is gitignored.

# ---- S3 face uploads (Level 3) ----
# Bucket that uploaded face images are written to (kept PRIVATE).
S3_UPLOAD_BUCKET=ai-video-dossier
S3_UPLOAD_REGION=eu-north-1
# Optional: key prefix inside the bucket (default "faces/")
# S3_UPLOAD_PREFIX=faces/
# Set to true ONLY if the bucket serves objects publicly; otherwise a presigned
# GET URL (valid 7 days) is generated and the bucket can stay private.
# S3_UPLOAD_PUBLIC=false

# ---- AWS credentials ----
# EITHER run `aws configure` (the SDK reads ~/.aws/credentials automatically) and
# leave these blank, OR put an access key here (needs s3:PutObject + s3:GetObject):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-north-1

# ---- Deployment (optional) ----
# Public origin of the deployed server (used only as a fallback face host when S3
# upload isn't configured). Not needed when S3_UPLOAD_BUCKET is set.
# PUBLIC_BASE_URL=https://your-app.onrender.com
